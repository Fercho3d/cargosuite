APP_NAME=CargoSuite
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# El nombre de la cookie de sesión va FIJO y neutro a propósito. Laravel lo
# deriva de APP_NAME, así que cambiarle el nombre a la marca renombraría la
# cookie, invalidaría la sesión de todo el mundo y les daría un 419 en el
# siguiente envío de formulario. La marca se cambia; la sesión no se entera.
SESSION_COOKIE=app_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Carpeta de adjuntos del sistema Frego (Yii2). Debe ser la misma que lee ese sistema.
FREGO_UPLOADS_PATH=

# Timbrado CFDI. TIMBRADO_PRODUCCION solo va en true en el servidor de produccion:
# sin el se timbra contra el ambiente de pruebas del PAC, que no genera documentos fiscales.
# ¿Esta instalación factura con CFDI? En falso desaparecen el timbrado,
# la cancelación, el aviso de facturas sin timbrar y los campos del SAT.
TIMBRADO_HABILITADO=true
TIMBRADO_PRODUCCION=false
TIMBRADO_RFC=
TIMBRADO_USER=
TIMBRADO_PASSWORD=

# Correo del sistema. Las direcciones concretas van en el bloque MARCA_* de
# más abajo; aquí solo el remitente de Laravel, que aquel toma por omisión.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# ---------------------------------------------------------------------
#  Documentos subidos (facturas PDF/XML y papeles del booking).
# ---------------------------------------------------------------------
DOCUMENTOS_PATH=

# ---------------------------------------------------------------------
#  Base con los datos del sistema anterior. Solo la usan las pruebas de
#  paridad; la aplicación entra por DB_DATABASE.
# ---------------------------------------------------------------------
FREGO_DB_DATABASE=

# ---------------------------------------------------------------------
#  MARCA — lo único que se cambia al instalarlo para otro cliente.
#  Explicado paso a paso en docs/MARCA-BLANCA.md.
# ---------------------------------------------------------------------
MARCA_NOMBRE=CargoSuite
MARCA_ETIQUETA=Cargo
MARCA_LEMA="Freight & Logistics Operations"
MARCA_PIE="Sistema interno confidencial"

# Vocabulario del negocio: carpeta dentro de lang/vocabulario/ cuyos textos
# ganan sobre los de base. Vacío = el de origen (agentes de carga).
# `servicios` = órdenes de servicio (taller, mantenimiento).
MARCA_VOCABULARIO=

# Idioma de los PDF y los correos que salen a clientes y proveedores. Va aparte
# del idioma de la interfaz: el documento lo lee el cliente, no el operador.
# Por omisión `en`, que es como los emitía el sistema anterior.
MARCA_IDIOMA_DOCUMENTOS=en

# Qué catálogos ve esta instalación, por slug y separados por comas.
# Vacío = los 17. Un taller deja fuera navieras, puertos, buques…
MARCA_CATALOGOS=

# De dónde sale el % de avance del expediente: `hitos` (los pasos del catálogo)
# o `verificacion` (las 27 casillas heredadas, con su divisor histórico de 26).
# `verificacion` SOLO en la instalación original, que lleva años viendo ese número.
MARCA_AVANCE=hitos

# Instalación de DEMOSTRACIÓN: enciende en Ajustes el botón que borra la base y
# la vuelve a llenar con los datos de una vertical (marítimo o terrestre).
# NUNCA en la instalación de un cliente.
MARCA_DEMO=false
MARCA_LANDING=true

# Taller: mantenimiento de unidades y almacén de refacciones. Solo con flota
# propia; apágalo si todo el mantenimiento se manda a un taller externo.
MARCA_TALLER=true

# Nómina interna: la plantilla y lo que se le paga a cada quien.
# Apágala en quien ya lleva la nómina en otro sistema. NO calcula IMSS, ISR ni
# timbra el CFDI de nómina: reúne lo que se paga y lo exporta.
MARCA_NOMINA=true

# Pantalla de Ajustes. Apágala cuando la instalación de un cliente la
# configura el dueño del producto: desaparece incluso para el super admin.
MARCA_AJUSTES=true

# Campos OPCIONALES del expediente que esta instalación no pide.
# Un taller: carrierId,brokerId,containerType,setPoint
MARCA_EXPEDIENTE_OCULTOS=

# Por qué atributos empareja el catálogo de precios con el expediente.
# Vacío = los cuatro de ruta. El cliente y el proveedor participan siempre.
# Claves: puerto_carga, puerto_descarga, destino_final, lugar_recoleccion
MARCA_EMPAREJADOR_DIMENSIONES=

# Dibujo de fondo del mapa de rutas: SVG o PNG del mundo en equirectangular
# (2:1), dentro de public/. Vacío = solo retícula y rutas.
MARCA_MAPA_FONDO=

# Perfil de los datos de demostración: carga (por omisión) o servicios.
DEMO_PERFIL=

# Logotipo de letra: se dibuja solo si no hay imagen configurada.
MARCA_LOGO_TEXTO=Cargo
MARCA_LOGO_ACENTO=Suite
MARCA_LOGO_SIMBOLO=

# Logotipo en imagen (rutas dentro de public/ o direcciones completas).
MARCA_LOGO_IMAGEN=
MARCA_LOGO_IMAGEN_OSCURO=
MARCA_FAVICON=

# Color de acento; se aplica sin recompilar los estilos.
MARCA_COLOR_400=
MARCA_COLOR_500=
MARCA_COLOR_600=
MARCA_COLOR_700=
MARCA_COLOR_TEXTO_CLARO=
MARCA_COLOR_TEXTO_OSCURO=

# Ficha impresa. El domicilio admite renglones separados por «|».
MARCA_EMPRESA=
MARCA_DOMICILIO=
MARCA_RFC=
MARCA_TELEFONO=
MARCA_PORTAL=

# Correo del sistema.
MARCA_MAIL_FROM=
MARCA_MAIL_FROM_NAME=
MARCA_MAIL_FACTURAS_BCC=
MARCA_MAIL_AVISOS=
MARCA_AVISOS_CORREO=false

# Tipo de cambio del dólar desde Banxico (SIE). Token gratis en
# https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=

# Sistema anterior (Yii2) para el enlace de la barra superior. Vacío: el mismo host en el puerto 80.
LEGACY_URL=
